---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BookingForm from '../components/BookingForm';
import { siteConfig, packages, vadodaraAreas } from '../lib/config';

const faqItems = [
  { q: `What anniversary celebration packages does Friends Factory Cafe Vadodara offer?`, a: `We offer 5 anniversary packages from ₹4,700 to ₹6,900, including Silver Love Setup, Golden Anniversary Rooftop, Romantic Anniversary Date, Anniversary Proposal Setup, and Grand Anniversary Celebration. Each includes candlelight décor, flowers, and a multi-course vegetarian meal.` },
  { q: `Can you arrange a vow renewal or anniversary proposal in Vadodara?`, a: `Yes! Our Anniversary Proposal Setup is perfect for renewing vows or proposing on your anniversary. We arrange a ring presentation, personalised banner, rose setup, and can coordinate photography assistance.` },
  { q: `How early should I book an anniversary dinner in Vadodara?`, a: `We recommend booking 24–48 hours in advance for standard packages. For highly customised setups or milestone anniversaries (25th, 50th), 3–5 days advance booking is ideal.` },
  { q: `Do you offer private dining for anniversary celebrations?`, a: `Yes. Our rooftop and terrace setups are private for couples. The Glass House area can be booked exclusively for larger anniversary parties as well.` },
  { q: `What is the price of an anniversary dinner at Friends Factory Cafe Vadodara?`, a: `Anniversary dinner packages start from ₹4,700 and go up to ₹6,900. All prices include full decoration, setup, and a complete meal. There are no hidden charges.` },
  { q: `Can I add a personalised anniversary photo or name banner?`, a: `Absolutely! We can add personalised photo printouts, name banners, and LED letter setups. Just mention your requirements when booking on WhatsApp.` },
];

const breadcrumbs = [{ name: 'Home', item: siteConfig.website }];
const waBookUrl = `https://wa.me/${siteConfig.whatsapp}?text=Hi Friends Factory Cafe! I'd like to book an Anniversary Celebration in Vadodara. Please share availability.`;
---

<Layout
  title={`Anniversary Dinner Vadodara | Romantic Setup ₹4,700 | Friends Factory Cafe`}
  description={`Celebrate your anniversary at Friends Factory Cafe Vadodara. Romantic candlelight dinners, private rooftop setups, and proposal arrangements from ₹4,700. Book via WhatsApp. 4.8★.`}
  canonical={siteConfig.website + '/'}
  breadcrumbs={breadcrumbs}
  faqSchema={faqItems}
>
  <Header />

  <section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-gradient-to-br from-stone-50 via-white to-amber-50/30">
    <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(circle at 25% 40%, var(--primary) 0%, transparent 50%), radial-gradient(circle at 75% 60%, var(--accent) 0%, transparent 50%);"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 glass rounded-full px-4 py-2 text-sm font-medium text-stone-600 mb-6">
            <span>💑</span><span>Vadodara's Finest Anniversary Venue</span>
          </div>
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-stone-900 leading-tight mb-6">
            Celebrate Your
            <span class="gradient-text block">Anniversary</span>
            in Vadodara
          </h1>
          <p class="text-lg text-stone-600 leading-relaxed mb-8 max-w-lg">
            Mark every year of love with a breathtaking anniversary celebration at Friends Factory Cafe. Private rooftop setups, candlelight dinners, and proposal arrangements from <strong>₹4,700</strong>.
          </p>
          <div class="flex flex-wrap gap-4 mb-8">
            <a href={waBookUrl} target="_blank" rel="noopener" class="btn-primary inline-flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Book Anniversary Dinner
            </a>
            <a href="#packages" class="inline-flex items-center gap-2 border border-stone-300 text-stone-700 hover:border-primary hover:text-primary px-6 py-3 rounded-xl font-medium transition-all">View Packages ↓</a>
          </div>
          <div class="flex items-center gap-6 text-sm text-stone-500">
            <div class="flex items-center gap-1.5"><span class="text-yellow-500">★★★★★</span><span>{siteConfig.rating} ({siteConfig.reviewCount}+ reviews)</span></div>
            <div class="flex items-center gap-1.5"><span>📍</span><span>Gotri, Vadodara</span></div>
          </div>
        </div>
        <div class="lg:pl-8">
          <BookingForm phone={siteConfig.phone} whatsapp={siteConfig.whatsapp} variant="hero" client:load />
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-4">How It Works</h2>
        <p class="text-stone-500 max-w-xl mx-auto">Three simple steps to a perfect anniversary celebration</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { step: '01', icon: '📅', title: 'Book Your Date', desc: 'Choose your anniversary date and package via WhatsApp. We confirm within minutes and start planning.' },
          { step: '02', icon: '🌹', title: 'We Prepare Everything', desc: 'Our team sets up roses, candles, personalised decor, and ensures your table is perfectly arranged.' },
          { step: '03', icon: '💑', title: 'Arrive & Celebrate', desc: 'Walk in together to a beautifully decorated anniversary setup. Savour the meal and make lasting memories.' },
        ].map(s => (
          <div class="glass rounded-2xl p-8 card-hover text-center">
            <div class="text-4xl mb-4">{s.icon}</div>
            <div class="text-xs font-bold text-stone-400 tracking-widest mb-2">STEP {s.step}</div>
            <h3 class="font-serif text-xl font-bold text-stone-900 mb-3">{s.title}</h3>
            <p class="text-stone-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="packages" class="py-20 bg-gradient-to-b from-stone-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-4">Anniversary <span class="gradient-text">Packages</span></h2>
        <p class="text-stone-500 max-w-xl mx-auto">Celebrate every milestone in style — all packages include full decoration and a romantic multi-course meal</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {packages.map((pkg, i) => (
          <div class={`rounded-2xl p-6 card-hover ${i === 2 ? 'bg-gradient-to-br from-primary to-accent text-white shadow-xl scale-[1.02]' : 'glass'}`}>
            {i === 2 && <div class="text-xs font-bold uppercase tracking-widest mb-3 opacity-80">⭐ Most Popular</div>}
            <div class="text-3xl mb-3">{pkg.emoji}</div>
            <h3 class={`font-serif text-xl font-bold mb-2 ${i === 2 ? 'text-white' : 'text-stone-900'}`}>{pkg.name}</h3>
            <div class={`text-2xl font-bold mb-3 ${i === 2 ? 'text-white' : 'gradient-text'}`}>{pkg.price}</div>
            <p class={`text-sm leading-relaxed mb-5 ${i === 2 ? 'text-white/85' : 'text-stone-500'}`}>{pkg.description}</p>
            <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi! I'd like to book the ${pkg.name} Anniversary package in Vadodara.`} target="_blank" rel="noopener"
              class={`block text-center py-2.5 rounded-xl text-sm font-medium transition-all ${i === 2 ? 'bg-white text-primary hover:bg-stone-100' : 'btn-primary'}`}>Book This Package</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 mb-3">Anniversary Dinners Across Vadodara</h2>
        <p class="text-stone-500">We serve couples across all major areas of Vadodara</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
        {vadodaraAreas.map(area => (
          <a href={`/${area.slug}-anniversary-dinner/`} class="text-center text-sm py-2.5 px-3 rounded-lg border border-stone-100 hover:border-primary/30 hover:bg-primary/5 text-stone-600 hover:text-primary transition-all">{area.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="py-20 bg-stone-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-stone-900 mb-4">Frequently Asked Questions</h2>
        <p class="text-stone-500">Everything about Anniversary Celebrations at Friends Factory Cafe</p>
      </div>
      <div class="space-y-4">
        {faqItems.map((item, i) => (
          <div class="glass rounded-xl overflow-hidden">
            <button class="w-full text-left flex items-center justify-between px-6 py-4 font-medium text-stone-900 hover:text-primary transition-colors faq-btn" data-index={i}>
              <span>{item.q}</span>
              <svg class="w-5 h-5 shrink-0 ml-4 faq-icon transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5 text-stone-500 text-sm leading-relaxed">{item.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-r from-primary to-accent">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">Celebrate Your Love Story Tonight</h2>
      <p class="text-white/85 text-lg mb-8">Book your Anniversary Dinner in Vadodara today. Instant confirmation via WhatsApp.</p>
      <a href={waBookUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white text-primary font-bold px-8 py-4 rounded-xl hover:bg-stone-100 transition-colors shadow-xl">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Book Now on WhatsApp
      </a>
      <p class="text-white/60 text-sm mt-4">Free booking • Instant confirmation • ₹4,700 onwards</p>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</Layout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = !answer.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));
      if (!isOpen) { answer.classList.remove('hidden'); icon.classList.add('rotate-180'); }
    });
  });
</script>
